# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bids_bazar
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT (RS256 — generate with: openssl genrsa 2048 | tee private.pem; openssl rsa -pubout -in private.pem -out public.pem)
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=64_hex_chars_here

# File uploads
UPLOAD_BASE_DIR=./uploads

# Mail (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=noreply@example.com
MAIL_PASSWORD=your_mail_password
MAIL_FROM="BidsBazar <noreply@example.com>"

# Frontend (used in email links)
APP_FRONTEND_URL=http://localhost:3000

# CORS — comma-separated list of allowed browser origins (no trailing slash).
# Include every origin your frontend is served from (dev + prod). Falls back
# to APP_FRONTEND_URL when unset.
CORS_ORIGINS=http://localhost:3001

# Bidding & Auction Lifecycle
BIDDING_DURATION_HOURS=24
PAYMENT_WINDOW_HOURS=18
BID_INCREMENT_MIN_FLAT=5
BID_INCREMENT_PERCENT=0.10

# Delivery (fixed, two-zone, cash on delivery — buyer selects zone at checkout)
DELIVERY_CHARGE_INSIDE_VALLEY=100
DELIVERY_CHARGE_OUTSIDE_VALLEY=250

# Fonepay Intent Checkout
# UAT/dev sandbox base URL (confirm with Fonepay which env your credentials target).
FONEPAY_BASE_URL=https://dev-external-gateway-new.fonepay.com/merchantThirdparty
FONEPAY_BASE_PATH=/api/merchant/third-party/v2
FONEPAY_USERNAME=labasam
FONEPAY_PASSWORD='F0nepay@123#'
FONEPAY_TERMINAL_ID=4271423331147924
# PKCS#8 private key — base64, no PEM header/footer, single line. Rotate for production.
FONEPAY_PRIVATE_
# Minutes before proactively re-logging in (default 10). Fonepay does not return explicit expiry.
FONEPAY_TOKEN_TTL_MINUTES=10
