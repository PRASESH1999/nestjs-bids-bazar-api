# Note: .env.development is loaded before .env and wins for duplicate keys.

# ---------- App ----------
NODE_ENV=development
PORT=8080
API_PREFIX=api
API_VERSION=v1

# ---------- Database (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bids_bazar
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ---------- Auth (JWT RS256) ----------
# Keys on one line, quoted, with newlines written as \n
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ---------- Security ----------
# 64 hex chars — generate with: openssl rand -hex 32
ENCRYPTION_KEY=64_hex_chars_here
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
LOG_LEVEL=debug

# ---------- File Uploads ----------
UPLOAD_BASE_DIR=./uploads

# ---------- Mail Service (SMTP) ----------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=noreply@example.com
MAIL_PASSWORD=your_mail_password
MAIL_FROM="BidsBazar <noreply@example.com>"

# ---------- Frontend & CORS ----------
# CORS_ORIGINS: comma-separated, no trailing slash (falls back to APP_FRONTEND_URL)
APP_FRONTEND_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:8001

# ---------- Social Login ----------
GOOGLE_CLIENT_ID=your_google_oauth_client_id
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ---------- Bidding & Auction ----------
BIDDING_DURATION_HOURS=24
PAYMENT_WINDOW_HOURS=18
BID_INCREMENT_MIN_FLAT=5
BID_INCREMENT_PERCENT=0.10

# ---------- Delivery ----------
# Flat fee (NPR), added to the Fonepay payment
DELIVERY_CHARGE_FLAT=130

# ---------- SMS (Sparrow) ----------
SPARROW_SMS_TOKEN=your_sparrow_sms_token
SPARROW_SMS_FROM=your_sparrow_sender_identity
SPARROW_SMS_BASE_URL=https://api.sparrowsms.com/v2/sms/

# ---------- Payments (Fonepay) ----------
# Sandbox: https://dev-external-gateway-new.fonepay.com/merchantThirdparty
# Live:    https://thirdparty-merchantapi.fonepay.com
FONEPAY_BASE_URL=https://dev-external-gateway-new.fonepay.com/merchantThirdparty
FONEPAY_BASE_PATH=/api/merchant/third-party/v2
FONEPAY_USERNAME=labasam
FONEPAY_PASSWORD='F0nepay@123#'
FONEPAY_TERMINAL_ID=4271423331147924
# PKCS#8 key, base64, single line, no PEM header/footer
FONEPAY_PRIVATE_
FONEPAY_TOKEN_TTL_MINUTES=10
BOOST_PAYMENT_WINDOW_MINUTES=15

# ---------- Courier (Pathao) ----------
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
PATHAO_CLIENT_ID=QK9b69QaEv
PATHAO_CLIENT_SECRET=k12nLGgq0zM3a65Sp65el4SZO6dhhMIxR0rDCavz
PATHAO_USERNAME=test.parcel@pathao.com
PATHAO_PASSWORD=lovePathao
PATHAO_STORE_ID=130903
# Comma-separated city ids we deliver to (65 = Kathmandu Valley)
PATHAO_VALLEY_CITY_IDS=65
