# Application
NODE_ENV=development
PORT=8080
API_PREFIX=api
API_VERSION=v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bids_bazar
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT (RS256 — generate with: openssl genrsa 2048 | tee private.pem; openssl rsa -pubout -in private.pem -out public.pem)
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=64_hex_chars_here

# File uploads
UPLOAD_BASE_DIR=./uploads

# Mail (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=noreply@example.com
MAIL_PASSWORD=your_mail_password
MAIL_FROM="BidsBazar <noreply@example.com>"

# Frontend (used in email links)
APP_FRONTEND_URL=http://localhost:8001

# CORS — comma-separated list of allowed browser origins (no trailing slash).
# Include every origin your frontend is served from (dev + prod). Falls back
# to APP_FRONTEND_URL when unset.
#
# NOTE: config is loaded from ['.env.development', '.env'] and the FIRST file
# wins per key. If you keep a .env.development, set this there too — a stale
# value in it silently overrides .env. The resolved list is printed at startup.
CORS_ORIGINS=http://localhost:8001

# Social login (token-verification flow: frontend obtains the token via the
# provider's SDK, backend verifies it — no OAuth callback URL needed)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Bidding & Auction Lifecycle
BIDDING_DURATION_HOURS=24
PAYMENT_WINDOW_HOURS=18
BID_INCREMENT_MIN_FLAT=5
BID_INCREMENT_PERCENT=0.10

# Delivery (flat, prepaid via Fonepay — bundled into the item's QR amount)
DELIVERY_CHARGE_FLAT=120

# Sparrow SMS (KYC phone OTP verification)
SPARROW_SMS_TOKEN=your_sparrow_sms_token
SPARROW_SMS_FROM=your_sparrow_sender_identity
SPARROW_SMS_BASE_URL=https://api.sparrowsms.com/v2/sms/

# Fonepay Intent Checkout
# UAT/dev sandbox base URL (confirm with Fonepay which env your credentials target).
FONEPAY_BASE_URL=https://dev-external-gateway-new.fonepay.com/merchantThirdparty
FONEPAY_BASE_PATH=/api/merchant/third-party/v2
FONEPAY_USERNAME=labasam
FONEPAY_PASSWORD='F0nepay@123#'
FONEPAY_TERMINAL_ID=4271423331147924
# PKCS#8 private key — base64, no PEM header/footer, single line. Rotate for production.
FONEPAY_PRIVATE_
# Minutes before proactively re-logging in (default 10). Fonepay does not return explicit expiry.
FONEPAY_TOKEN_TTL_MINUTES=10

# Boost payments (fixed-price Fonepay QR purchase window, in minutes)
BOOST_PAYMENT_WINDOW_MINUTES=15

# Pathao Courier Merchant API (warehouse -> buyer leg only)
# Sandbox credentials below — swap to live values only (no code change) when
# actually going live.
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
PATHAO_CLIENT_ID=QK9b69QaEv
PATHAO_CLIENT_SECRET=k12nLGgq0zM3a65Sp65el4SZO6dhhMIxR0rDCavz
PATHAO_USERNAME=test.parcel@pathao.com
PATHAO_PASSWORD=lovePathao
# The warehouse's single Pathao Store id — register the store once via
# Pathao's own onboarding, then paste its id here. No default: fill in after
# registration.
PATHAO_STORE_ID=
# Comma-separated Pathao city_ids we can currently fulfil to (Kathmandu
# Valley only). Confirmed against the sandbox: Pathao models the whole
# valley as ONE city ("Kathmandu Valley", city_id 65) rather than separate
# Kathmandu/Lalitpur/Bhaktapur entries — re-verify against the live
# environment before go-live in case it differs there.
PATHAO_VALLEY_CITY_IDS=65
